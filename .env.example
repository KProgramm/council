# Shared team model. In the app, use Connections > Use team Brev model.
LLM_PROVIDER=brev
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=https://council-model-api-5l9p30nnv.gobrev.dev
LLM_API_KEY=
# Alternative provider settings (Cisco proxy or LiteLLM-supported provider).
LLM_MODEL=
LLM_BASE_URL=
MAX_CONCURRENT_LLM_CALLS=1
BUS=memory            # memory | slim
SLIM_ENDPOINT=http://localhost:46357
SLIM_SHARED_SECRET=   # must equal the SLIM server PASSWORD (32+ chars)

# Optional: GitHub token with Pull requests: Read permission for selected private repos.
# Public repositories work without a token. Keep tokens in .env, never in the browser.
GITHUB_TOKEN=
