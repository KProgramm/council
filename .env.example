LLM_MODEL=
LLM_API_KEY=
MAX_CONCURRENT_LLM_CALLS=3
BUS=memory            # memory | slim
SLIM_ENDPOINT=http://localhost:46357
SLIM_SHARED_SECRET=   # must equal the SLIM server PASSWORD (32+ chars)

GITHUB_TOKEN=        # fine-grained PAT: Contents R/W, Pull requests R/W, Checks R (private repos need it)
MAX_PR_FILES=25
